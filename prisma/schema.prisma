generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A person who can send or receive shoutouts. Mirrors a Keycloak user.
model User {
  id          String    @id @default(cuid())
  /// Keycloak subject (user id). Stable even if email/name change.
  keycloakId  String    @unique @map("keycloak_id")
  email       String    @unique
  name        String
  avatarUrl   String?   @map("avatar_url")
  /// False when the user is disabled or removed in Keycloak.
  active      Boolean   @default(true)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sent      Shoutout[]          @relation("SentShoutouts")
  received  ShoutoutRecipient[]
  reactions Reaction[]
  comments  Comment[]
  reports   Report[]   @relation("Reporter")
  resolved  Report[]   @relation("Resolver")
  auditLogs AuditLog[]

  @@index([active, name])
  @@map("users")
}

/// A card design people pick when sending a shoutout.
model Card {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  tagline      String
  /// Illustration key, see src/components/cards/illustrations.tsx.
  illustration String
  /// Colour tone, see src/components/cards/designs.ts.
  tone         String
  active       Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shoutouts Shoutout[]

  @@map("cards")
}

/// A company value a shoutout can be tagged with.
model CompanyValue {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shoutouts Shoutout[]

  @@map("company_values")
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum ModerationStatus {
  /// Normal.
  VISIBLE
  /// Reported and hidden until an admin reviews it.
  HIDDEN
  /// Removed by an admin after review.
  REMOVED
}

model Shoutout {
  id         String     @id @default(cuid())
  senderId   String     @map("sender_id")
  cardId     String     @map("card_id")
  valueId    String     @map("value_id")
  message    String     @db.VarChar(280)
  visibility Visibility @default(PUBLIC)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  editedAt   DateTime?  @map("edited_at")
  /// Set when the sender deletes it; deleted shoutouts are hidden and refund budget.
  deletedAt  DateTime?  @map("deleted_at")
  moderationStatus ModerationStatus @default(VISIBLE) @map("moderation_status")

  sender     User                @relation("SentShoutouts", fields: [senderId], references: [id])
  card       Card                @relation(fields: [cardId], references: [id])
  value      CompanyValue        @relation(fields: [valueId], references: [id])
  recipients ShoutoutRecipient[]
  reactions  Reaction[]
  comments   Comment[]
  reports    Report[]

  @@index([createdAt(sort: Desc), id])
  @@index([senderId, createdAt])
  @@map("shoutouts")
}

model ShoutoutRecipient {
  shoutoutId String @map("shoutout_id")
  userId     String @map("user_id")

  shoutout Shoutout @relation(fields: [shoutoutId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@id([shoutoutId, userId])
  @@index([userId])
  @@map("shoutout_recipients")
}

/// An emoji reaction. The emoji is a key from src/lib/reactions.ts.
model Reaction {
  shoutoutId String   @map("shoutout_id")
  userId     String   @map("user_id")
  emoji      String
  createdAt  DateTime @default(now()) @map("created_at")

  shoutout Shoutout @relation(fields: [shoutoutId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@id([shoutoutId, userId, emoji])
  @@map("reactions")
}

model Comment {
  id         String    @id @default(cuid())
  shoutoutId String    @map("shoutout_id")
  authorId   String    @map("author_id")
  body       String    @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  /// Set when the author deletes it.
  deletedAt  DateTime? @map("deleted_at")

  shoutout Shoutout @relation(fields: [shoutoutId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([shoutoutId, createdAt])
  @@map("comments")
}

enum ReportReason {
  INAPPROPRIATE
  OFFENSIVE
  SPAM
  OTHER
}

enum ReportResolution {
  RESTORED
  REMOVED
}

/// Someone flagged a shoutout. The shoutout is hidden until an admin resolves it.
model Report {
  id           String            @id @default(cuid())
  shoutoutId   String            @map("shoutout_id")
  reporterId   String            @map("reporter_id")
  reason       ReportReason
  note         String?           @db.VarChar(500)
  createdAt    DateTime          @default(now()) @map("created_at")
  resolvedAt   DateTime?         @map("resolved_at")
  resolution   ReportResolution?
  resolvedById String?           @map("resolved_by_id")

  shoutout   Shoutout @relation(fields: [shoutoutId], references: [id], onDelete: Cascade)
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id])
  resolvedBy User?    @relation("Resolver", fields: [resolvedById], references: [id])

  @@unique([shoutoutId, reporterId])
  @@index([resolvedAt, createdAt])
  @@map("reports")
}

/// Who did what in the admin area and moderation.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String   @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
